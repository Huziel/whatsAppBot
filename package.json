{
  "name": "whatsapp-mysql-archive",
  "version": "1.0.0",
  "private": true,
  "description": "Captura local de conversaciones individuales de WhatsApp en MySQL mediante Baileys",
  "scripts": {
    "dev:server": "tsx watch src/index.ts",
    "dev:styles": "tailwindcss -i web/styles.css -o web/assets/dashboard.css --watch",
    "build:styles": "tailwindcss -i web/styles.css -o web/assets/dashboard.css",
    "dev": "npm run build:styles && concurrently -k -n server,tailwind \"npm:dev:server\" \"npm:dev:styles\"",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs && tailwindcss -i web/styles.css -o dist/public/assets/dashboard.css --minify",
    "start": "node dist/src/index.js",
    "migrate": "tsx src/migrate.ts",
    "stats": "tsx src/stats.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@hapi/boom": "10.0.1",
    "@whiskeysockets/baileys": "6.7.24",
    "dotenv": "16.4.7",
    "luxon": "3.7.2",
    "mysql2": "3.24.5",
    "pino": "9.6.0",
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.0",
    "@types/luxon": "3.7.6",
    "@types/node": "22.13.4",
    "@types/qrcode-terminal": "0.12.2",
    "@types/ws": "8.5.14",
    "concurrently": "9.2.5",
    "tailwindcss": "4.3.0",
    "tsx": "4.19.3",
    "typescript": "5.7.3"
  }
}
